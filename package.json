{
  "name": "dsh-managed-agent",
  "version": "0.2.1",
  "description": "受管设备代理（DSH 插件）：读取本机设备凭据，周期上报 DSH 版本 / patch 指纹 / 插件清单，并提供本地只读状态页。只上报状态与计数，不上报提示词、回复、文件内容或凭据。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "managed",
    "compliance",
    "heartbeat",
    "device"
  ],
  "author": "XILEJUN (https://github.com/tableau-China)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tableau-China/dsh-managed-agent.git"
  },
  "homepage": "https://github.com/tableau-China/dsh-managed-agent#readme",
  "bugs": {
    "url": "https://github.com/tableau-China/dsh-managed-agent/issues"
  },
  "scripts": {
    "test": "node test/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
